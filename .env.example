# ───────────────────────────── Eldermere — environment ─────────────────────────────
# Copy this file to `.env` and fill in what you need. `.env` is gitignored — NEVER commit
# real secrets. Every value below is OPTIONAL: Eldermere runs fully out of the box with
# none of them set. In that default mode, bots use the built-in OFFLINE scripted brain, so
# NO API key of any kind is required to run the world or the rendezvous demo.

# ───────── HTTP / WebSocket ─────────
# Port the server listens on (binds to 127.0.0.1; put a reverse proxy in front for public access).
PORT=3000

# Comma-separated allowlist of browser origins permitted for CORS and the WebSocket origin check.
# Add your public host here in production. Leave blank to allow same-origin only.
ALLOWED_ORIGINS=http://localhost:3000

# Force pure open-metaverse mode (ignore any optional private deployment overlay). Set to 1 to
# guarantee a 100% brand-neutral deployment. Leave blank/0 for normal operation.
BRAND_NEUTRAL=

# Auto-run the built-in demo shortly after boot (default on). Set to 0 to disable.
AUTO_DEMO=

# Override the SQLite world database file (relative paths resolve under data/). Handy for tests
# and the headless demo so they don't share the live world.db. Leave blank for the default.
WORLD_DB=

# ───────── Admin console (/admin) ─────────
# Password for the admin console. CHANGE THIS in production. If unset, a random one is
# generated and printed to the log once at boot.
ADMIN_PASSWORD=

# ───────── Grok brain (xAI) — OPTIONAL online brain ─────────
# If set, bots created with brain="grok" will use the xAI API. Without a key, every bot falls
# back to the built-in offline scripted brain and the whole app still works.
XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_API_BASE=https://api.x.ai/v1

# ───────── Bot Beacons adapter (ntfy + AES-256) — OPTIONAL. Inert if unset. ─────────
# One-way encrypted notifications bridge. Leave blank to keep it disabled.
BOT_BEACONS_NTFY_TOPIC=
BOT_BEACONS_NTFY_SERVER=https://ntfy.sh
# 32-byte AES-256 key, hex (64 chars) or base64.
BOT_BEACONS_AES_KEY=
