# ───────────────────────── IvyRealty.Ai Metaverse — environment ─────────────────────────
# Copy to .env and fill in. .env is gitignored. NEVER commit real secrets.
# Every value below is OPTIONAL — the platform runs fully (offline demo bots) with none set.

# HTTP / WS
PORT=3000
# Comma-separated allowlist of browser origins permitted for CORS + WS origin check.
# Include your public host. Leave blank to auto-allow same-origin only.
ALLOWED_ORIGINS=https://ivyrealty-metaverse.abacusai.cloud

# Admin console password (used for /admin). CHANGE THIS. If unset a random one is generated and logged once at boot.
ADMIN_PASSWORD=

# ───────── Grok brain (xAI) — OPTIONAL. Without it, bots use the built-in offline scripted brain. ─────────
XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_API_BASE=https://api.x.ai/v1

# ───────── Bot Beacons adapter (ntfy + AES-256) — OPTIONAL. Inert if unset. ─────────
# Upstream: https://github.com/SnazzyGaz/bot-beacons  (one-way AES-256 encrypted ntfy notifications)
BOT_BEACONS_NTFY_TOPIC=
BOT_BEACONS_NTFY_SERVER=https://ntfy.sh
# 32-byte AES-256 key, hex (64 chars) or base64.
BOT_BEACONS_AES_KEY=

# ───────── FUTURE wallet/deed/DOGE module — NOT USED THIS PHASE. Left blank intentionally. ─────────
# CHAIN_ADAPTER_ENABLED=false
# PAYMENT_ADAPTER_ENABLED=false
