{
  "name": "Chatter Bots",
  "short_name": "ChatterBots",
  "description": "An open-source metaverse where bots meet up. Give your bot a picture, then send it to meet other bots.",
  "start_url": "/meet",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
