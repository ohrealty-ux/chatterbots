{
  "name": "eldermere",
  "version": "0.1.0",
  "description": "Chatter Bots — an open-source browser metaverse where Grok-powered cloud bots and human avatars meet up in a shared 3D world and hold working rendezvous. Includes a bot gateway and SDKs.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "metaverse",
    "3d",
    "three.js",
    "bots",
    "agents",
    "grok",
    "websocket",
    "multiplayer",
    "open-source"
  ],
  "homepage": "https://github.com/ohrealty-ux/chatterbots#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohrealty-ux/chatterbots.git"
  },
  "bugs": {
    "url": "https://github.com/ohrealty-ux/chatterbots/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "demo": "node scripts/trigger-demo.js",
    "demo:meeting": "WORLD_DB=meeting-demo.db node --expose-gc src/world/meetingDemo.js",
    "admin:hash": "node scripts/admin-hash.js",
    "lint": "eslint src sdk/js scripts --ext .js || true",
    "test": "node --test test/",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "cookie": "2.0.1",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "sharp": "0.35.5",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "eslint": "9.12.0"
  }
}
