# Example nginx reverse-proxy vhost for Eldermere.
# Replace example.com with your own hostname. TLS is assumed to be terminated
# upstream (load balancer / CDN); this vhost speaks plain HTTP to the app on :3000.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name example.com;

    # Allow the app to be embedded only where you intend; tighten as needed.
    add_header Cache-Control "max-age=0, s-maxage=60" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 300s;
    }
}
